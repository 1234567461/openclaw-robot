# LLM（OpenAI 兼容）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# Telegram 渠道（可选）
TELEGRAM_BOT_TOKEN=

# 飞书渠道（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Minecraft bot（重点）
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=ClawBot
# 离线模式（online-mode=false 的服务器）无需密码
MC_AUTH=offline
# 正版服务器用 microsoft 账号
# MC_AUTH=microsoft
# MC_EMAIL=you@example.com
# MC_PASSWORD=

# Unitree 物理机器人（可选）
UNITREE_IP=
