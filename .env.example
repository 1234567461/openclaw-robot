# ===== LLM 后端（本地 / 云端，OpenAI 兼容接口）=====
# 切换后端只改这三行，无需改代码。或用代码 LLM.create("ollama")

# 云端 OpenAI
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# 云端 DeepSeek（取消注释切换）
# LLM_API_BASE=https://api.deepseek.com
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat

# 本地 Ollama（先 ollama serve，key 填任意非空）
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 本地 vLLM（vllm serve --model Qwen/Qwen2.5-7B）
# LLM_API_BASE=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=qwen2.5-7b

# 云端硅基流动 SiliconFlow
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===== Telegram 渠道（可选）=====
TELEGRAM_BOT_TOKEN=

# ===== 飞书渠道（可选）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# ===== Web 聊天渠道（可选）=====
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ===== Minecraft bot（通过 RCON 连接，支持 1.9+ 任意版本）=====
# 需在 MC 服务器的 server.properties 开启：
#   enable-rcon=true
#   rcon.password=你的密码
#   rcon.port=25575
MC_HOST=127.0.0.1
MC_USERNAME=ClawBot
MC_RCON_PORT=25575
MC_RCON_PASSWORD=your_rcon_password

# ===== Unitree 物理机器人（可选）=====
UNITREE_IP=
